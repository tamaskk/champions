# apps/web reads these from apps/web/.env.local
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=champion
# Admin login (/admin-login). Without ADMIN_PASSWORD nobody can open /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Random string that signs the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
API_FOOTBALL_KEY=
# Coins (apps/web/src/server/wallet-data.ts). In production these stay unset:
#   REVENUECAT_WEBHOOK_AUTH – the Authorization header value set in RevenueCat's webhook settings
#   ADS_SIMULATED=1 / PURCHASES_SIMULATED=1 – only for a staging server (never in production)
REVENUECAT_WEBHOOK_AUTH=
ADS_SIMULATED=
PURCHASES_SIMULATED=
# Data pipeline (packages/pipeline): Transfermarkt pages are fetched through Apify's web-fetch Actor
APIFY_TOKEN=

# Password-reset emails (Resend). Without them: dev prints the code to the server log,
# production offers only the backup-code reset.
RESEND_API_KEY=
EMAIL_FROM=
