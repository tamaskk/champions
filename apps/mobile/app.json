{
  "expo": {
    "name": "Spinvincible",
    "slug": "champion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spinvincible",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.spinvincible.app",
